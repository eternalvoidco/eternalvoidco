{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.eternalvoid.co" }],
      "destination": "https://eternalvoid.co/$1",
      "permanent": true
    },
    { "source": "/collection", "destination": "/shop", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/artist-submission", "destination": "/api/artists?_ev_artist_route=/api/artist-submission" },
    { "source": "/api/artist-submissions", "destination": "/api/artists?_ev_artist_route=/api/artist-submissions" },
    { "source": "/api/artist-royalties", "destination": "/api/artists?_ev_artist_route=/api/artist-royalties" },
    { "source": "/api/artist-reversals", "destination": "/api/artists?_ev_artist_route=/api/artist-reversals" },
    { "source": "/api/artist-drafts-sweep", "destination": "/api/artists?_ev_artist_route=/api/artist-drafts-sweep" },
    { "source": "/api/artist-opening", "destination": "/api/artists?_ev_artist_route=/api/artist-opening" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/story", "destination": "/index.html" },
    { "source": "/newsletter", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/for-artists", "destination": "/for-artists/index.html" },
    { "source": "/for-artists/terms", "destination": "/for-artists/index.html" },
    { "source": "/for-artists/submit", "destination": "/for-artists/index.html" },
    { "source": "/fragrance/scent", "destination": "/fragrance/index.html" },
    { "source": "/fragrance/details", "destination": "/fragrance/index.html" },
    { "source": "/fragrance/notify", "destination": "/fragrance/index.html" },
    { "source": "/legal/ev-for-artists-submission-terms", "destination": "/legal/ev-for-artists-submission-terms/index.html" },
    { "source": "/legal/ev-for-artists-submission-terms/2026-11-19", "destination": "/legal/ev-for-artists-submission-terms/2026-11-19/index.html" },
    { "source": "/legal/ev-for-artists-privacy-notice", "destination": "/legal/ev-for-artists-privacy-notice/index.html" },
    { "source": "/legal/ev-for-artists-privacy-notice/2026-11-19", "destination": "/legal/ev-for-artists-privacy-notice/2026-11-19/index.html" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/checkout/success", "destination": "/checkout/success/index.html" },
    { "source": "/admin/inventory", "destination": "/admin/inventory/index.html" },
    { "source": "/admin/artists", "destination": "/admin/artists/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://flagcdn.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://*.supabase.co wss://*.supabase.co https://api.stripe.com; media-src 'self'; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|mov|woff|woff2|ico|png|jpg|jpeg|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/inventory?sweep=1", "schedule": "17 4 * * *" },
    { "path": "/api/artist-drafts-sweep", "schedule": "41 4 * * *" }
  ]
}
