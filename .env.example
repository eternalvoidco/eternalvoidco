# ─────────────────────────────────────────────────────────────────────────────
# VOID — environment variables
#
# These two values are PUBLIC (safe to expose to the browser) and are served to
# the frontend by /api/config. Set them in Vercel → Project → Settings →
# Environment Variables (Production + Preview), and in a local .env for
# `vercel dev`. Copy this file to .env and fill in real values.
#
# NEVER put the Supabase service_role (secret) key here or anywhere in the
# frontend — it must stay server-side only. It is not used by this project.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Your Supabase publishable / anon key (starts with "sb_publishable_" or is the
# legacy anon JWT). Public by design — safe on the frontend.
SUPABASE_ANON_KEY=

# ── Existing project variables (unrelated to auth) ──
# ANTHROPIC_API_KEY=      # used by /api/concierge (server-side only)
# RESEND_API_KEY=         # used by /api/preorder and order confirmation emails


# ─────────────────────────────────────────────────────────────────────────────
# CHECKOUT
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only. Bypasses RLS, so it must never be sent to the browser and is
# never returned by /api/config. Used by the checkout and webhook functions to
# write orders. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Start with TEST keys (pk_test_… / sk_test_…).
# The publishable key is served to the browser by /api/config, by design.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe-webhook endpoint (whsec_…). Copy it from
# Stripe → Developers → Webhooks after adding the endpoint. Without this the
# webhook refuses every request, and no order can ever be marked paid.
STRIPE_WEBHOOK_SECRET=

# ── Delivery rates ──────────────────────────────────────────────────────────
# In MINOR UNITS (cents): 990 = €9.90. No rates are hardcoded anywhere in the
# code, because none exist for this business yet — inventing one would put a
# fabricated figure on a real invoice.
#
# A zone with no configured rate is simply not offered at checkout, and the
# customer is told delivery there is not available yet. Set at least one before
# testing a payment end to end.
VOID_SHIP_HU_STANDARD=
VOID_SHIP_HU_EXPRESS=
VOID_SHIP_EU_STANDARD=
VOID_SHIP_EU_EXPRESS=
VOID_SHIP_INTL_STANDARD=

# ── Not yet configurable ────────────────────────────────────────────────────
# VAT / tax: there is no tax model in this project and product prices carry no
# stated tax treatment, so checkout computes zero and records it in the order's
# tax_amount column. Decide the model (inclusive vs added, rates per country)
# before selling — see taxAmountFor() in api/_catalog.js.
#
# Inventory: no stock exists in any data source, so nothing is decremented on
# purchase and nothing can oversell-protect. See stockFor() in api/_catalog.js.
