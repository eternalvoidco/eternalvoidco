# ─────────────────────────────────────────────────────────────────────────────
# VOID — environment variables
#
# These two values are PUBLIC (safe to expose to the browser) and are served to
# the frontend by /api/config. Set them in Vercel → Project → Settings →
# Environment Variables (Production + Preview), and in a local .env for
# `vercel dev`. Copy this file to .env and fill in real values.
#
# NEVER put the Supabase service_role (secret) key here or anywhere in the
# frontend — it must stay server-side only. It is not used by this project.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Your Supabase publishable / anon key (starts with "sb_publishable_" or is the
# legacy anon JWT). Public by design — safe on the frontend.
SUPABASE_ANON_KEY=

# ── Existing project variables (unrelated to auth) ──
# ANTHROPIC_API_KEY=      # used by /api/concierge (server-side only)
